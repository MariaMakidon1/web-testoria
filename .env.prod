# ── Testoria Frontend — Production ────────────────────────────────────
# Baked into the build at `npm run build` time (VITE_ vars only)

# API Base URL — points to the production API subdomain
VITE_API_URL=https://api.testoria.gammait.net/api/v1

# Mock Mode — must be false in production
VITE_MOCK_ENABLED=false
